build/bin
build/linux
build/cli
build/whisper
# make app-icons' working directory, left behind if a render fails
build/.icons/
dist
node_modules
frontend/dist
vendor/
# A plain go build in the root writes the app binary here; nothing reads it
# and releases build their own.
/agentry-desktop
# make build-windows writes the WebView2 bootstrapper here before makensis runs
build/windows/installer/tmp/
# The stamped resource files a platform build generates, and the Windows
# resource file that gives the exe its icon and properties.
build/.generated/
*.syso
# Local credentials never enter the tree: secrets live in an .env file.
.env
.env.*
# The design harness writes its screenshots here (node harness/shots.mjs).
frontend/harness/shots/
__pycache__/
