build/bin
build/linux
# make app-icons' working directory, left behind if a render fails
build/.icons/
dist
node_modules
frontend/dist
vendor/
# wails build -nsis drops the WebView2 bootstrapper here before makensis runs
build/windows/installer/tmp/
# Local credentials never enter the tree (agentry-desktop#128): the estate's
# convention for secrets is an .env file. build/release.env is a committed,
# non-secret build input and is not matched by these patterns.
.env
.env.*
