# What the release workflow bakes into every artifact it builds. Not a
# secret: a reviewable, committed statement of which site a downloaded build
# talks to when the person configures nothing (a binary downloaded from a
# registry's download page connects to that registry; see
# https://docs.secureagentry.net/agentry/downloads/). Both registries are
# named, and this file is the same on main and dev: scripts/release-registry.sh
# picks one by the released commit's first-parent history (a commit on main's
# line is a production release, one on dev's a dev release, anything else is
# refused), the same mechanism the CLI's release uses. A line that differed
# per branch would diverge on every merge. The update channel is the chosen
# registry's downloads manifest, so the two cannot drift apart.
AGENTRY_REGISTRY_PRODUCTION=https://secureagentry.net
AGENTRY_REGISTRY_DEV=https://dev.secureagentry.net
# The OAuth Client ID Metadata Documents the sign-ins of the CLI module the
# app embeds present: the native client of every MCP sign-in and the Hugging
# Face client. The same on both channels: vendors know the client by this
# address.
AGENTRY_NATIVE_CLIENT_METADATA_URL=https://secureagentry.net/oauth/clients/agentry-desktop.json
AGENTRY_HF_CLIENT_METADATA_URL=https://secureagentry.net/oauth/clients/agentry-huggingface.json
# The CN the Windows signature must carry: the name Artifact Signing
# validated (an individual). scripts/check-windows-installer.sh
# --signed refuses a release signed by any other name, which is what makes
# the signature ours rather than any Artifact Signing customer's — the root
# they chain to is shared.
AGENTRY_WINDOWS_SIGNING_CN="Chris Dupres"
# The macOS Developer ID identity and its team. Public: both are in every
# signature. The certificate (SHA-1 5952E3CFEF0C5575750568A351FAF8EC5CA393D6, issued by
# Developer ID Certification Authority G2, expires 2031-09-17) and its key
# are the APPLE_DEVELOPER_ID_P12 secret; nothing reads these two lines until
# the macos job signs and notarizes.
APPLE_SIGNING_IDENTITY="Developer ID Application: Chris Dupres (5K7DTJ5AA5)"
APPLE_TEAM_ID=5K7DTJ5AA5
