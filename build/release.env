# What the release workflow bakes into every artifact it builds. Not a
# secret: a reviewable, committed statement of which site a downloaded build
# talks to when the person configures nothing (docs/agentry/downloads.md on
# the site: "A binary downloaded from a registry's download page connects to
# that registry"). Both registries are named, and this file is the same on
# main and dev: scripts/release-registry.sh picks one by the released commit's
# first-parent history (a commit on main's line is a production release, one
# on dev's a dev release, anything else is refused), the CLI's mechanism
# adopted unchanged (agentry-desktop#183, agentry-cli#240, DR-33). A line that
# differed per branch could only be set on main by a direct commit, which
# main never takes. The update channel is the chosen registry's downloads
# manifest, so the two cannot drift apart.
AGENTRY_REGISTRY_PRODUCTION=https://secureagentry.net
AGENTRY_REGISTRY_DEV=https://dev.secureagentry.net
# The CN the Windows signature must carry: the name Artifact Signing
# validated (an individual, plan os-code-signing.md D1), as the first signed
# dry run (35620578957) reported it. scripts/check-windows-installer.sh
# --signed refuses a release signed by any other name, which is what makes
# the signature ours rather than any Artifact Signing customer's — the root
# they chain to is shared (agentry-desktop#54).
AGENTRY_WINDOWS_SIGNING_CN="Chris Dupres"
# The macOS Developer ID identity and its team (agentry-desktop#152; plan
# os-code-signing.md M-M1 step 4). Public: both are in every signature. The
# certificate (SHA-1 5952E3CFEF0C5575750568A351FAF8EC5CA393D6, issued by
# Developer ID Certification Authority G2, expires 2031-09-17) and its key
# are the APPLE_DEVELOPER_ID_P12 secret; nothing reads these two lines until
# the macos job signs and notarizes (agentry-desktop#6).
APPLE_SIGNING_IDENTITY="Developer ID Application: Chris Dupres (5K7DTJ5AA5)"
APPLE_TEAM_ID=5K7DTJ5AA5
